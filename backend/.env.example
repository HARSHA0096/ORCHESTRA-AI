# ─── Application ───────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug

# ─── Database ──────────────────────────────
DATABASE_URL=postgresql://orchestra:orchestra_secret@localhost:55433/orchestra_db?schema=public

# ─── Redis ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ───────────────────────────────────
JWT_SECRET=change-this-to-a-very-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-this-to-another-very-long-random-secret-32-chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── API Keys ─────────────────────────────
API_KEY_SALT=change-this-salt-min-16-chars
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEVELOPMENT_PROJECT_ID=

# ─── CORS ──────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Rate Limiting ─────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Queue ─────────────────────────────────
QUEUE_PREFIX=orchestra

# Demo submission mode
DEMO_MODE=false
DEMO_PROJECT_ID=
